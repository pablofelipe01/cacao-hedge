# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# cobertura de tests
/coverage

# Históricos descargados de barchart.com.
# Son datos de un proveedor comercial: publicarlos en el repositorio sería
# redistribuirlos. Quedan en la máquina de cada quien y se cargan por
# /importar. Los tests que los usan se saltan solos si no están.
/docs/*.csv
