# =====================================================================
# CacaoHedge — variables de entorno
#
# ⚠️  ESTE ARCHIVO SE SUBE AL REPOSITORIO.
#     Solo debe contener marcadores, nunca valores reales.
#     Los valores de verdad van en .env.local, que está en .gitignore.
#
# Copie este archivo a .env.local y complete allí.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase
# Dashboard -> Project Settings -> API
#
# Nota: Next.js solo expone al navegador las variables con prefijo
# NEXT_PUBLIC_. Por eso la URL y la anon key lo llevan; la service role
# key NO, porque salta RLS y solo puede usarse en el servidor.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------
# Anthropic — informe ejecutivo narrativo (fase 5)
# Se usa EXCLUSIVAMENTE desde el servidor. El LLM redacta e interpreta;
# todas las cifras las calcula el motor en /src/lib/engine.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------
# Barchart OnDemand (opcional)
# Una cuenta estándar de barchart.com NO incluye la API OnDemand: es un
# producto aparte. Si esta variable está vacía, el sistema usa el
# continuo CC=F de Yahoo o los históricos importados por CSV.
# ---------------------------------------------------------------------
BARCHART_API_KEY=

# ---------------------------------------------------------------------
# Fuentes públicas (los valores por defecto funcionan tal cual)
# TRM oficial: dataset Socrata de datos.gov.co
# ---------------------------------------------------------------------
TRM_ENDPOINT=https://www.datos.gov.co/resource/32sa-8pi3.json
# Token de aplicación de Socrata (opcional; sube el límite de peticiones)
SOCRATA_APP_TOKEN=

# URL pública de la app (callbacks de autenticación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
